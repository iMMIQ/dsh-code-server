#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# The vendor runtime has no bundled node; prefer the one the DSH host
# exports, else fall back to node from PATH for standalone CLI use.
if [ -z "${NODE_EXEC_PATH:-}" ]; then
  NODE_EXEC_PATH="$(command -v node || true)"
  export NODE_EXEC_PATH
fi
exec "$script_dir/../vendor/code-server/bin/code-server" "$@"
