{
  "name": "dsh-ask",
  "displayName": "Ask, Fix & Chat DSH",
  "description": "Chat with DSH in the editor, and send files, selections, or reported problems to the DeepSeek Harness agent session",
  "publisher": "immiq",
  "version": "0.1.8",
  "private": true,
  "license": "LGPL-3.0",
  "engines": {
    "vscode": "^1.132.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dsh.ask",
        "title": "DSH: Ask About This Selection"
      },
      {
        "command": "dsh.fixFile",
        "title": "DSH: Fix Problems in This File"
      },
      {
        "command": "dsh.explainSelection",
        "title": "DSH: Explain Selection"
      },
      {
        "command": "dsh.fixSelection",
        "title": "DSH: Fix Selection"
      },
      {
        "command": "dsh.reviewSelection",
        "title": "DSH: Review Selection"
      },
      {
        "command": "dsh.explainTerminal",
        "title": "DSH: Explain Terminal Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dsh.ask",
          "when": "editorTextFocus",
          "group": "9_dsh@0"
        },
        {
          "command": "dsh.explainSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_dsh@1"
        },
        {
          "command": "dsh.fixSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_dsh@2"
        },
        {
          "command": "dsh.reviewSelection",
          "when": "editorTextFocus && editorHasSelection",
          "group": "9_dsh@3"
        }
      ],
      "terminal/context": [
        {
          "command": "dsh.explainTerminal",
          "group": "9_dsh@0"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "immiq.dsh",
        "name": "dsh",
        "description": "Chat with the DeepSeek Harness agent session for this workspace",
        "isSticky": true,
        "isDefault": true,
        "locations": ["editor", "terminal"],
        "modes": ["ask", "agent", "edit"],
        "commands": [
          {
            "name": "fix",
            "description": "fix the problems reported in the active editor"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "copilot",
        "displayName": "DSH",
        "isDefault": true
      }
    ]
  }
}
